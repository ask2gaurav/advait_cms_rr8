# MongoDB connection (admin / build only — never deployed to production)
MONGODB_URI=mongodb://localhost:27017/cms

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Master user created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Site Admin

# Media uploads
MAX_UPLOAD_MB=10

# Canonical production URL of the public site (used for sitemap / SEO)
SITE_URL=https://www.advaitsolutions.com
